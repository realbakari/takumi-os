# --- The keyboard light ------------------------------------------------------------------------------------------------
kbd() { rm -rf "${TAKUMI_LEDS:?}"; mkdir -p "$TAKUMI_LEDS/tpacpi::kbd_backlight"; echo "$1" > "$TAKUMI_LEDS/tpacpi::kbd_backlight/max_brightness"; echo "$2" > "$TAKUMI_LEDS/tpacpi::kbd_backlight/brightness"; }
level() { cat "$TAKUMI_LEDS/tpacpi::kbd_backlight/brightness"; }
reset; kbd 2 0
out=$(commands/keys/backlight up)
check "up: a step, and a notice with a meter ($out)" '[[ "$out" == "Keyboard light 50%" && "$(level)" == 1 ]] && grep -qx "brightnessctl -q -d tpacpi::kbd_backlight set 1" "$FAKE/calls" && grep -q "^keyboard|Keyboard light||50|" "$FAKE/notices"'
commands/keys/backlight up >/dev/null; commands/keys/backlight up >/dev/null
check "up stops at the top" '[[ "$(level)" == 2 ]]'
out=$(commands/keys/backlight down)
check "down: a step ($out)" '[[ "$out" == "Keyboard light 50%" && "$(level)" == 1 ]]'
out=$(commands/keys/backlight cycle); out2=$(commands/keys/backlight cycle)
check "round: brighter, then off ($out, $out2)" '[[ "$out" == "Keyboard light 100%" && "$out2" == "Keyboard light off" && "$(level)" == 0 ]] && grep -q "^keyboard|Keyboard light off||0|" "$FAKE/notices"'
commands/keys/backlight cycle >/dev/null; echo 0 > "$TAKUMI_LEDS/tpacpi::kbd_backlight/brightness"; : > "$FAKE/notices"
commands/keys/backlight restore
check "restore after waking: back to the level chosen, without a notice" '[[ "$(level)" == 1 && ! -s "$FAKE/notices" ]]'
rm -f "$XDG_RUNTIME_DIR/takumi-kbd-backlight"; echo 0 > "$TAKUMI_LEDS/tpacpi::kbd_backlight/brightness"; commands/keys/backlight restore
check "restore with nothing chosen here leaves the light to the laptop" '[[ "$(level)" == 0 ]]'
kbd 255 0; seen=""; for _ in 1 2 3 4; do commands/keys/backlight cycle >/dev/null; seen+="$(level) "; done
check "a light with many levels goes round in thirds ($seen)" '[[ "$seen" == "85 170 255 0 " ]]'
rm -rf "${TAKUMI_LEDS:?}"; rc=0; out=$(commands/keys/backlight up) || rc=$?
check "no keyboard light: says so, 3; restore stays quiet" '[[ $rc -eq 3 && "$out" == "This keyboard has no light" ]] && commands/keys/backlight restore'

# --- The touchpad ---------------------------------------------------------------------------------------------------------
