# --- The microphone light -----------------------------------------------------------------------------------------------------
reset; mic=$TAKUMI_LEDS/platform::micmute; mkdir -p "$mic"; echo 0 > "$mic/brightness"; echo "none kbd-capslock [audio-micmute]" > "$mic/trigger"
# pactl's events: muted, then the choice of microphone changes to an unmuted one, then something else. Each waits for
# the light to show the last change, and writes down what it saw.
cat > "$FAKE/events" <<'EVENTS'
led="$TAKUMI_LEDS/platform::micmute"
seen() { i=0; while [ "$(cat "$led/brightness")" != "$1" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done; cat "$led/brightness" >> "$FAKE/seen"; }
cat "$led/trigger" > "$FAKE/trigger-while"
seen 0
touch "$FAKE/mic-muted"; echo "Event 'change' on source #57"; seen 1
rm -f "$FAKE/mic-muted"; echo "Event 'change' on server #4294967295"; seen 0
echo "Event 'new' on sink-input #9"
EVENTS
rc=0; commands/power/micled || rc=$?
check "the light follows the mute of the microphone in use ($(tr "\n" " " < "$FAKE/seen"))" '[[ "$(tr "\n" " " < "$FAKE/seen")" == "0 1 0 " ]]'
check "taken from the kernel's trigger while it runs, given back after" '[[ "$(cat "$FAKE/trigger-while")" == none && "$(cat "$mic/trigger")" == audio-micmute ]]'
check "when the sound server goes away it ends for systemd to start it again: 1" '[[ $rc -eq 1 ]]'
printf '%s\n' 'touch "$FAKE/mic-muted"; echo "Event '"'"'change'"'"' on source #57"; sleep 0.5' > "$FAKE/events"; rm -f "$FAKE/mic-muted"
chmod 444 "$mic/brightness"; commands/power/micled || true
check "a light this user may not write goes through brightnessctl and logind" '[[ -w "$mic/brightness" ]] || grep -qx "brightnessctl -q -d platform::micmute set 1" "$FAKE/calls"'
chmod 644 "$mic/brightness"; rm -rf "${TAKUMI_LEDS:?}"
check "no microphone light: nothing to do" 'commands/power/micled'

# --- Hibernating while an update waits ---------------------------------------------------------------------------------
# The room in use (the default) and an older one, their boot entries, and a start an hour ago. stage <room> <when>: an
# update staged a room then, with its entry set to be tried.
hook=default/systemd/system-sleep/takumi-rooms
export TAKUMI_STATE=$root/var/lib/takumi/state
rooms() {
  mkdir -p "$TAKUMI_STATE" "$root/efi/loader/entries" "$root/run/takumi"
  printf 'status=good\n' > "$TAKUMI_STATE/20261101-201512"; printf 'status=good\n' > "$TAKUMI_STATE/20261108-093000"
  : > "$root/efi/loader/entries/takumi-20261101-201512.conf"; : > "$root/efi/loader/entries/takumi-20261108-093000.conf"
  echo '[{"id":"takumi-20261108-093000.conf","isDefault":true},{"id":"takumi-20261101-201512.conf","isDefault":false}]' > "$FAKE/entries.json"
  echo "btime $(( $(date +%s) - 3600 ))" > "$root/proc/stat"
}
stage() { printf 'status=staged\nstaged=%s\n' "$2" > "$TAKUMI_STATE/$1"; : > "$root/efi/loader/entries/takumi-$1+3.conf"; }
oneshots() { grep '^bootctl set-oneshot' "$FAKE/calls" | sed 's/^bootctl set-oneshot //' | tr '\n' '|'; }
sleeping() { SYSTEMD_SLEEP_ACTION=$1 "$hook" "$2" "$3"; }   # <what part> <pre|post> <the kind of sleep>
reset; rooms
sleeping suspend pre suspend; sleeping suspend post suspend; sleeping suspend pre suspend-then-hibernate
sleeping hibernate pre hibernate; sleeping hibernate post hibernate
check "sleep, and hibernating with no update waiting, leave the next start as it is" '[[ -z "$(oneshots)" && ! -e "$root/run/takumi/hibernating" ]]'
stage 20261109-101500 "$(date -u +%FT%TZ)"; sleeping hibernate pre hibernate
check "an update waiting: before hibernating, the next start is the room in use" '[[ "$(oneshots)" == "takumi-20261108-093000.conf|" && "$(cat "$root/run/takumi/hibernating")" == 20261109-101500 ]]'
sleeping hibernate post hibernate
check "after waking, the update is set to be tried at the next start again" '[[ "$(oneshots)" == "takumi-20261108-093000.conf|takumi-20261109-101500.conf|" && ! -e "$root/run/takumi/hibernating" ]]'
: > "$FAKE/calls"; sleeping suspend pre suspend-then-hibernate; sleeping suspend post suspend-then-hibernate
check "suspend-then-hibernate while it only sleeps: nothing" '[[ -z "$(oneshots)" ]]'
sleeping hibernate pre suspend-then-hibernate; sleeping hibernate post suspend-then-hibernate
check "suspend-then-hibernate once it hibernates: the same as hibernating" '[[ "$(oneshots)" == "takumi-20261108-093000.conf|takumi-20261109-101500.conf|" ]]'
: > "$FAKE/calls"; "$hook" pre hybrid-sleep; "$hook" post hybrid-sleep
check "a hybrid sleep, told only by its name, too" '[[ "$(oneshots)" == "takumi-20261108-093000.conf|takumi-20261109-101500.conf|" ]]'
reset; rooms; stage 20261105-120000 2026-11-05T12:00:00Z
sleeping hibernate pre hibernate; sleeping hibernate post hibernate
check "a room staged before this start had its one try: it is not tried again" '[[ -z "$(oneshots)" ]]'
reset; rooms; echo '[{"id":"takumi-20261101-201512.conf","isDefault":true},{"id":"takumi-20261108-093000.conf","isDefault":false}]' > "$FAKE/entries.json"
sleeping hibernate pre hibernate; sleeping hibernate post hibernate
check "an older room started by hand: it wakes as itself, then the default starts as before" '[[ "$(oneshots)" == "takumi-20261108-093000.conf||" ]]'
reset; rooms; stage 20261109-101500 "$(date -u +%FT%TZ)"; rm "$root/efi/loader/entries/takumi-20261108-093000.conf"
out=$(sleeping hibernate pre hibernate 2>&1)
check "a room without a boot entry is not pointed at, and the journal says why" '[[ -z "$(oneshots)" && ! -e "$root/run/takumi/hibernating" && "$out" == "takumi-rooms: room 20261108-093000 has no boot entry, so the next start stays as it was" ]]'
reset; rooms; stage 20261109-101500 "$(date -u +%FT%TZ)"; echo "rw,relatime,subvol=/@" > "$FAKE/options"
sleeping hibernate pre hibernate
check "a computer without rooms: nothing" '[[ -z "$(oneshots)" ]]'

# Leaving: shut down, restart and log out ask every window to close first, and wait for an app that asks
# about unsaved work. A fake niri keeps its windows in a file; a window whose app is "keeper" never closes.
cp "$t/bin/niri" "$t/niri.plain"
cat > "$t/bin/niri" <<'FAKE'
#!/bin/sh
printf "niri %s\n" "$*" >> "$FAKE/calls"
case "$*" in
  "msg --json windows") cat "$FAKE/windows" ;;
  "msg action close-window --id "*) id=$5
    jq -c --argjson id "$id" 'map(select(.id != $id or .app_id == "keeper"))' "$FAKE/windows" > "$FAKE/windows.new" && mv "$FAKE/windows.new" "$FAKE/windows" ;;
esac
FAKE
chmod +x "$t/bin/niri"
mkdir -p "$HOME/.local/share/applications"; printf '[Desktop Entry]\nName=Text Editor\n' > "$HOME/.local/share/applications/keeper.desktop"
export TAKUMI_CLOSE_WAIT=1
: > "$FAKE/calls"; : > "$FAKE/notices"
echo '[{"id":4,"app_id":"firefox","title":"News"},{"id":9,"app_id":"foot","title":"~"}]' > "$FAKE/windows"
rc=0; takumi power off >/dev/null 2>&1 || rc=$?
check "shutting down asks each window to close, then turns off" '[[ $rc == 0 ]] && grep -q "close-window --id 4" "$FAKE/calls" && grep -q "close-window --id 9" "$FAKE/calls" && grep -q "systemctl poweroff" "$FAKE/calls"'
: > "$FAKE/calls"
echo '[{"id":4,"app_id":"firefox","title":"News"},{"id":7,"app_id":"keeper","title":"notes.txt"}]' > "$FAKE/windows"
rc=0; out=$(takumi power restart 2>&1) || rc=$?
check "an app that stays open (unsaved work) stops the restart" '[[ $rc == 3 ]] && ! grep -q "systemctl reboot" "$FAKE/calls"'
check "it is brought to the front and named in the Core ($out)" 'grep -q "focus-window --id 7" "$FAKE/calls" && grep -q "^power|Text Editor still open|Save or close it, then restart again|" "$FAKE/notices"'
: > "$FAKE/calls"
echo '[]' > "$FAKE/windows"
rc=0; takumi power logout >/dev/null 2>&1 || rc=$?
check "nothing open: logging out goes straight on" '[[ $rc == 0 ]] && grep -q "action quit --skip-confirmation" "$FAKE/calls" && ! grep -q close-window "$FAKE/calls"'
cp "$t/niri.plain" "$t/bin/niri"; unset TAKUMI_CLOSE_WAIT

# An update holds sleep off while it runs, with a lock that ends with it (power_hold_awake).
: > "$FAKE/calls"
bash -c '. "$1/lib/power.sh"; power_hold_awake "Preparing an update"; sleep 0.3' _ "$repo"; sleep 0.3
check "an update holds sleep and idle off for as long as it runs" 'grep -q "^systemd-inhibit --what=sleep:idle --who=Takumi --why=Preparing an update --mode=block tail --pid=[0-9]* -f /dev/null$" "$FAKE/calls"'
check "the update and its preparing both hold it" 'grep -q "power_hold_awake \"Preparing an update\"" commands/update/main && grep -q "power_hold_awake \"Preparing an update\"" commands/update/prepare'

echo "   $(grep -c '^check ' "$0") power checks against a fake laptop"
exit $status
