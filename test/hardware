#!/usr/bin/env bash
# Contract checks for This computer (lib/hardware.sh, default/hardware/*.toml, commands/hardware/*, the Palette's
# hardware rows) against fake computers: every fix reads and names only keys Takumi knows; the fixes that match a
# ThinkPad with NVIDIA, a desktop with an old GeForce, three Macs, a Framework, a Surface, an Apple Silicon Mac,
# a virtual machine, and the models with fixes of their own (ASUS ROG, Dell XPS, Yoga, Panther Lake, Framework 13
# AMD and 16, Surface Pro 11) and Xbox gear; the rows and cards a person sees; takumi hardware apply into a fake room (packages, kernel
# options, files, services, the initramfs, the record, and taking back what no longer applies); and what
# takumi doctor says. Fake tools first in PATH record their arguments. Runs on bash 3.2 with jq.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
command -v jq >/dev/null || { echo "   (jq not installed; hardware checks skipped)"; exit 0; }
repo=$PWD; status=0; n=0
t=$(mktemp -d "${TMPDIR:-/tmp}/takumi-hw.XXXXXX"); trap 'rm -rf "${t:?}"' EXIT
export FAKE=$t/state HOME=$t/home XDG_RUNTIME_DIR=$t/run
mkdir -p "$t/bin" "$FAKE" "$HOME" "$XDG_RUNTIME_DIR" "$t/commands/room"
export PATH="$t/bin:$repo/bin:$PATH"
export TAKUMI_COMMANDS="$t/commands:$repo/commands"   # fake takumi commands go in front of the real ones
export TAKUMI_HW_DATA=$repo/default/hardware TAKUMI_HW_RECORD=$t/record.json TAKUMI_HW_ROOM=20261108-090000
unset TAKUMI_OFFLINE TAKUMI_PACMAN_CONF
check() { n=$((n + 1)); if ! eval "$2"; then echo "   FAIL: $1"; status=1; fi; }
lib() { bash -c '. lib/hardware.sh; "$@"' _ "$@"; }

# --- Fake tools: each records its arguments in $FAKE/calls.
fake() { printf '#!/usr/bin/env bash\n%s\n' "$2" > "$t/bin/$1"; chmod +x "$t/bin/$1"; }
fake pacman 'printf "pacman %s\n" "$*" >> "$FAKE/calls"
case " $* " in
  *" -Slq "*) cat "$FAKE/repo" ;;
  *" -Qq "*) cat "$FAKE/installed" 2>/dev/null || true ;;
  *" -S "*) [[ -f "$FAKE/pacman-fails" ]] && exit 1; for a in "$@"; do case "$a" in -*|--*) ;; *) echo "$a" >> "$FAKE/installed" ;; esac; done ;;
esac'
fake arch-chroot 'printf "arch-chroot %s\n" "$*" >> "$FAKE/calls"; shift; exec "$@"'
fake systemctl 'printf "systemctl %s\n" "$*" >> "$FAKE/calls"'
fake mkinitcpio 'printf "mkinitcpio %s\n" "$*" >> "$FAKE/calls"'
fake id 'if [[ "$1" == -u ]]; then cat "$FAKE/uid"; else exec /usr/bin/id "$@"; fi'
fake fprintd-list 'cat "$FAKE/fprint"'
printf '#!/bin/sh\nexit 1\n' > "$t/commands/room/enabled"; chmod +x "$t/commands/room/enabled"
echo 0 > "$FAKE/uid"; : > "$FAKE/calls"

# --- Fake computers: machine <name> points every hardware path at one.
mk() {  # <name> <arch> <sys_vendor> <product_name> <product_version> <chassis> <cpu vendor> <family> <model> <model name> [flag]
  local d=$t/m/$1; mkdir -p "$d/sys/class/dmi/id" "$d/asound" "$d/firmware"
  : > "$d/lspci"; : > "$d/lsusb"; : > "$d/klog"; : > "$d/dt"; echo "$2" > "$d/arch"
  echo "$3" > "$d/sys/class/dmi/id/sys_vendor"; echo "$4" > "$d/sys/class/dmi/id/product_name"
  echo "$5" > "$d/sys/class/dmi/id/product_version"; echo "$6" > "$d/sys/class/dmi/id/chassis_type"
  printf 'processor\t: 0\nvendor_id\t: %s\ncpu family\t: %s\nmodel\t\t: %s\nmodel name\t: %s\ncpu cores\t: 8\nflags\t\t: fpu sse %s\n' \
    "$7" "$8" "$9" "${10}" "${11:-}" > "$d/cpuinfo"
  echo 'MemTotal:       15600000 kB' > "$d/meminfo"
}
pci() {  # <machine> <slot> <class> <vendor> <device> <vendor name> <device name> <driver> [subsystem name]
  { printf 'Slot:\t%s\nClass:\tController [%s]\nVendor:\t%s [%s]\nDevice:\t%s [%s]\nSVendor:\tMaker [1234]\nSDevice:\t%s [5678]\n' \
      "$2" "$3" "$6" "$4" "$7" "$5" "${9:-Device}"
    [[ -z "$8" ]] || printf 'Driver:\t%s\n' "$8"
    printf '\n'; } >> "$t/m/$1/lspci"
}
usb() { printf 'Bus 003 Device 004: ID %s %s\n' "$2" "$3" >> "$t/m/$1/lsusb"; }
machine() {
  local d=$t/m/$1
  export TAKUMI_HW_LSPCI=$d/lspci TAKUMI_HW_LSUSB=$d/lsusb TAKUMI_HW_SYS=$d/sys TAKUMI_HW_CPUINFO=$d/cpuinfo TAKUMI_HW_MEMINFO=$d/meminfo
  export TAKUMI_HW_DT=$d/dt TAKUMI_HW_ASOUND=$d/asound TAKUMI_HW_KERNEL_LOG=$d/klog TAKUMI_HW_FIRMWARE=$d/firmware TAKUMI_HW_ARCH=$(cat "$d/arch")
}
matched() { machine "$1"; takumi hardware detect | jq -r '[.matches[].id] | join(" ")'; }

