# --- What a person sees, before anything is set up.
rows=$(takumi hardware --json)
says() { jq -r --arg id "$1" 'select(.id == $id) | .title + " · " + .subtitle' <<< "$rows"; }
check "the computer, its processor and memory" '[[ "$(says hw:computer)" == "This computer: Lenovo ThinkPad X1 Carbon Gen 11 · 13th Gen Intel Core i7-1365U · 16 GB memory" ]]'
check "a part whose fix is not set up says so" '[[ "$(says hw:pci:01:00.0)" == "Graphics: NVIDIA GeForce RTX 4070 Max-Q / Mobile · set up at the next update" ]]'
check "Bluetooth works, named with its maker" '[[ "$(says hw:bt:hci0)" == "Bluetooth: Intel AX211 Bluetooth · works" ]]'
check "the sound chip by its own name" '[[ "$(says hw:pci:00:1f.3)" == "Sound: Realtek ALC287 · set up at the next update" ]]'
check "the GPU's own sound is not a row" '[[ -z "$(says hw:pci:01:00.1)" ]]'
check "one row offers the update, in the Core, asking first" '[[ "$(jq -c "select(.id == \"hw:pending\") | [.run, .packages[0:2]]" <<< "$rows")" == "[[\"takumi\",\"update\"],[\"nvidia-open\",\"nvidia-utils\"]]" ]]'
check "at a terminal: one line per part, and what is not set up" '[[ "$(takumi hardware | head -n 1)" == "This computer: Lenovo ThinkPad X1 Carbon Gen 11 · 13th Gen Intel Core i7-1365U · 16 GB memory" && "$(takumi hardware | tail -n 1)" == "Not set up yet: NVIDIA graphics, Fingerprint reader and 7 more. takumi update sets them up, in a new system." ]]'

# --- Apply into a fake room being built, a copy of the running room 20261108-090000.
newroom() {  # <name>: a fresh root that looks like an installed system
  local r=$t/top/@rooms/$1
  rm -rf "$r"; mkdir -p "$r/etc/kernel" "$r/usr/lib/systemd/system" "$r/usr/bin"
  echo "rd.luks.name=1111=takumi root=/dev/mapper/takumi rw quiet splash" > "$r/etc/kernel/cmdline"
  printf '[options]\nArchitecture = auto\n\n[core]\nInclude = /etc/pacman.d/mirrorlist\n' > "$r/etc/pacman.conf"
  for u in thermald.service nvidia-suspend.service nvidia-resume.service; do : > "$r/usr/lib/systemd/system/$u"; done
  printf '#!/bin/sh\n' > "$r/usr/bin/mkinitcpio"; chmod +x "$r/usr/bin/mkinitcpio"
  printf '%s' "$r"
}
everything=$(jq -r '.apply.packages // [] | .[]' <<< "$fixes" | sort -u)
reset() { : > "$FAKE/calls"; printf '%s\n' "$everything" > "$FAKE/repo"; printf 'base\nlinux\n' > "$FAKE/installed"; rm -f "$FAKE/pacman-fails"; }
reset; rm -f "$TAKUMI_HW_RECORD"
r=$(newroom 20261109-101500)
out=$(takumi hardware apply --root "$r" 2>&1) && rc=0 || rc=$?
check "apply into a room: done ($rc)" '[[ $rc -eq 0 ]]'
check "one pacman call in the room, without 32-bit libraries when multilib is off" '[[ $(grep -c "^pacman.*-S --needed --noconfirm" "$FAKE/calls") -eq 1 ]] && grep -q "^arch-chroot $r pacman -S --needed --noconfirm .*nvidia-open" "$FAKE/calls" && ! grep -q "lib32-" "$FAKE/installed"'
check "kernel options added once, after the ones already there" '[[ "$(cat "$r/etc/kernel/cmdline")" == "rd.luks.name=1111=takumi root=/dev/mapper/takumi rw quiet splash nvidia_drm.modeset=1 nvidia_drm.fbdev=1" ]]'
check "modprobe options, each fix named" 'grep -qx "# NVIDIA graphics (nvidia-open.toml)" "$r/etc/modprobe.d/takumi-hardware.conf" && grep -qx "options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp" "$r/etc/modprobe.d/takumi-hardware.conf" && grep -qx "options psmouse synaptics_intertouch=1" "$r/etc/modprobe.d/takumi-hardware.conf"'
check "NVIDIA's udev rules" '[[ $(grep -c "ATTR{vendor}==\"0x10de\"" "$r/etc/udev/rules.d/90-takumi-hardware.rules") -eq 4 ]]'
check "early drivers, each one allowed to be absent" 'grep -qx "MODULES+=(nvidia? nvidia_modeset? nvidia_uvm? nvidia_drm?)" "$r/etc/mkinitcpio.conf.d/takumi-hardware.conf"'
check "services turned on in the room; one the room lacks is said" 'grep -q "^systemctl --root=$r enable thermald.service" "$FAKE/calls" && grep -q "^systemctl --root=$r enable nvidia-suspend.service" "$FAKE/calls" && grep -q "nvidia-hibernate.service is not in this system" <<< "$out"'
check "the initramfs is made again inside the room" 'grep -q "^arch-chroot $r mkinitcpio -P" "$FAKE/calls"'
rec=$(jq -c '.rooms["20261109-101500"]' "$TAKUMI_HW_RECORD")
check "recorded under the room: every fix set up, 32-bit libraries left out and why" '[[ "$(jq -r "[.fixes[].status] | unique | join(\" \")" <<< "$rec")" == applied && "$(jq -r ".fixes[] | select(.id == \"nvidia-open\") | .skipped[0] | .package + \": \" + .why" <<< "$rec")" == "lib32-nvidia-utils: multilib is off" ]]'
check "recorded: the options and services it added, the initramfs" '[[ "$(jq -c "[.cmdline_added, (.services_enabled | length), .initramfs]" <<< "$rec")" == "[[\"nvidia_drm.modeset=1\",\"nvidia_drm.fbdev=1\"],3,\"rebuilt\"]" ]]'
: > "$FAKE/calls"; out=$(takumi hardware apply --root "$r" 2>&1)
check "again on the same room: nothing doubled, nothing installed twice, the record still knows its options" '[[ "$(cat "$r/etc/kernel/cmdline")" == "rd.luks.name=1111=takumi root=/dev/mapper/takumi rw quiet splash nvidia_drm.modeset=1 nvidia_drm.fbdev=1" ]] && ! grep -q -- "-S --needed" "$FAKE/calls" && [[ "$(jq -c ".rooms[\"20261109-101500\"].cmdline_added" "$TAKUMI_HW_RECORD")" == "[\"nvidia_drm.modeset=1\",\"nvidia_drm.fbdev=1\"]" ]]'
check "files that did not change are left alone" '! grep -q "wrote" <<< "$out"'

# The rows, now that the running room is the one set up.
export TAKUMI_HW_ROOM=20261109-101500
rows=$(takumi hardware --json)
check "set up, but the old driver still runs: after a restart" '[[ "$(says hw:pci:01:00.0)" == "Graphics: NVIDIA GeForce RTX 4070 Max-Q / Mobile · set up; in use after a restart" ]]'
tab=$(printf '\t'); sed -i.bak "s/^Driver:${tab}nouveau\$/Driver:${tab}nvidia/" "$TAKUMI_HW_LSPCI"
echo "found 1 devices" > "$FAKE/fprint"
rows=$(takumi hardware --json)
check "NVIDIA's own driver in use" '[[ "$(says hw:pci:01:00.0)" == "Graphics: NVIDIA GeForce RTX 4070 Max-Q / Mobile · NVIDIA'"'"'s own driver · rests when no app uses it" ]]'
check "Wi-Fi works" '[[ "$(says hw:pci:00:14.3)" == "Wi-Fi: Intel Wi-Fi 6E AX211 · works" ]]'
check "the IPU6 camera says plainly how far it works" '[[ "$(says hw:fix:intel-ipu6-camera)" == "Camera: Intel IPU6 · works on some models" ]]'
check "the fingerprint reader, as fprintd sees it" '[[ "$(says hw:fix:fingerprint)" == "Fingerprint reader: Goodix · works" ]]'
echo "No devices available" > "$FAKE/fprint"; rows=$(takumi hardware --json)
check "a reader fprintd cannot drive" '[[ "$(says hw:fix:fingerprint)" == "Fingerprint reader: Goodix · not supported yet" ]]'
check "the processor's fixes, and the count on the computer" '[[ "$(says hw:cpu)" == "Processor: 13th Gen Intel Core i7-1365U · kept cool by thermald" && "$(says hw:computer)" == *" · 9 fixes in use" ]]'
check "nothing left to set up: no update row" '[[ -z "$(jq -r "select(.id == \"hw:pending\") | .id" <<< "$rows")" ]]'
card=$(takumi hardware --card hw:fix:intel-ipu6-camera)
check "Enter on a part: a card that says it in sentences" '[[ "$(jq -r .kicker <<< "$card")" == "This computer" && "$(jq -r .title <<< "$card")" == "Camera: Intel IPU6" && "$(jq -r .detail <<< "$card")" == "Cameras on Intel"*"A USB camera works everywhere." ]]'
takumi hardware --card hw:nope >/dev/null 2>&1 && rc=0 || rc=$?
check "a card for a part that is gone: exit 3" '[[ $rc -eq 3 ]]'

# --- The Palette's rows.
p() { takumi palette hardware "$1"; }
check "\"computer\" lists every part, nearest the field the computer itself" '[[ $(p computer | wc -l) -ge 9 && "$(p computer | jq -sr "sort_by(-.score) | .[0].title")" == "This computer: Lenovo ThinkPad X1 Carbon Gen 11" ]]'
check "a part's row opens its card" '[[ "$(p camera | jq -c "[.kind, .card, .run]")" == "[\"Hardware\",true,[\"takumi\",\"hardware\",\"--card\",\"hw:fix:intel-ipu6-camera\"]]" ]]'
check "\"nvidia\" finds the graphics" '[[ "$(p nvidia | jq -r .title)" == "Graphics: NVIDIA GeForce RTX 4070 Max-Q / Mobile" ]]'
check "\"wifi\" alone stays with the networks; \"wifi card\" finds the chip" '[[ -z "$(p wifi)" && "$(p "wifi card" | jq -r .title)" == "Wi-Fi: Intel Wi-Fi 6E AX211" ]]'
check "other searches and short ones leave it quiet" '[[ -z "$(p firefox)" && -z "$(p gr)" ]]'

# --- A computer that changed: a new room copied from the one set up, on a machine without NVIDIA and whose
# touchpad message is gone (its fix is kept).
awk 'BEGIN { RS = ""; ORS = "\n\n" } !/NVIDIA/' "$TAKUMI_HW_LSPCI.bak" > "$TAKUMI_HW_LSPCI"
: > "$TAKUMI_HW_KERNEL_LOG"
r2=$t/top/@rooms/20261110-080000; rm -rf "$r2"; cp -R "$r" "$r2"
reset; out=$(takumi hardware apply --root "$r2" 2>&1) && rc=0 || rc=$?
check "the options a gone fix added are taken back, the others stay ($rc)" '[[ $rc -eq 0 && "$(cat "$r2/etc/kernel/cmdline")" == "rd.luks.name=1111=takumi root=/dev/mapper/takumi rw quiet splash" ]]'
check "the services it turned on are turned off" 'grep -q "^systemctl --root=$r2 disable nvidia-suspend.service" "$FAKE/calls" && ! grep -q "disable thermald.service" "$FAKE/calls"'
check "files no fix needs are removed, the kept touchpad fix stays" '[[ ! -e "$r2/etc/udev/rules.d/90-takumi-hardware.rules" && ! -e "$r2/etc/mkinitcpio.conf.d/takumi-hardware.conf" ]] && grep -qx "options psmouse synaptics_intertouch=1" "$r2/etc/modprobe.d/takumi-hardware.conf" && ! grep -q nvidia "$r2/etc/modprobe.d/takumi-hardware.conf"'
check "the initramfs is made again for the changed options" 'grep -q "^arch-chroot $r2 mkinitcpio -P" "$FAKE/calls"'
check "the kept fix is recorded as kept and set up" '[[ "$(jq -r ".rooms[\"20261110-080000\"].fixes[] | select(.id == \"synaptics-intertouch\") | .status" "$TAKUMI_HW_RECORD")" == applied ]]'

# --- Packages the root's repositories lack, on the setup disc and online; pacman failing; multilib on.
machine mac2013
reset; grep -vx "broadcom-wl-dkms" "$FAKE/repo" > "$FAKE/repo.new"; mv "$FAKE/repo.new" "$FAKE/repo"
r3=$(newroom 20261111-090000)
out=$(TAKUMI_OFFLINE=1 TAKUMI_PACMAN_CONF=/etc/takumi/setup-pacman.conf takumi hardware apply --root "$r3" 2>&1) && rc=0 || rc=$?
check "on the setup disc, a fix whose package the disc lacks waits for the first update ($rc)" '[[ $rc -eq 0 ]] && grep -q "Broadcom Wi-Fi: not set up, broadcom-wl-dkms is not on the setup disc" <<< "$out" && [[ "$(jq -r ".rooms[\"20261111-090000\"].fixes[] | select(.id == \"broadcom-wl\") | .status" "$TAKUMI_HW_RECORD")" == waiting ]]'
check "a fix is set up whole or not at all: its headers are not installed alone" '! grep -qx linux-headers "$FAKE/installed"'
check "the setup disc's packages come through its own pacman.conf" 'grep -q "^arch-chroot $r3 pacman --config /etc/takumi/setup-pacman.conf -S --needed --noconfirm" "$FAKE/calls"'
reset; grep -vx "broadcom-wl-dkms" "$FAKE/repo" > "$FAKE/repo.new"; mv "$FAKE/repo.new" "$FAKE/repo"
takumi hardware apply --root "$r3" >/dev/null 2>&1 || true
check "online, a package the repositories do not carry: unavailable, not waiting" '[[ "$(jq -r ".rooms[\"20261111-090000\"].fixes[] | select(.id == \"broadcom-wl\") | .status" "$TAKUMI_HW_RECORD")" == unavailable ]]'
reset; touch "$FAKE/pacman-fails"; printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> "$r3/etc/pacman.conf"
takumi hardware apply --root "$r3" >/dev/null 2>&1 && rc=0 || rc=$?
check "pacman failing: exit 1, and the fixes that needed it wait for the next update" '[[ $rc -eq 1 && "$(jq -r ".rooms[\"20261111-090000\"].fixes[] | select(.id == \"intel-graphics\") | .status" "$TAKUMI_HW_RECORD")" == failed ]]'
check "with multilib on, 32-bit libraries are asked for" 'grep -q "lib32-vulkan-intel" "$FAKE/calls"'
echo 1000 > "$FAKE/uid"; takumi hardware apply --root "$r3" >/dev/null 2>&1 && rc=0 || rc=$?; echo 0 > "$FAKE/uid"
check "not as root: exit 1" '[[ $rc -eq 1 ]]'
takumi hardware apply --root >/dev/null 2>&1 && rc=0 || rc=$?
check "usage: exit 2" '[[ $rc -eq 2 ]]'
out=$(takumi hardware apply --root "$r3" --data "$t/none" 2>&1) && rc=0 || rc=$?
check "no data: exit 1, said, nothing changed" '[[ $rc -eq 1 && "$out" == *"no hardware data in $t/none"* ]]'

# --- A Framework 16: Framework's tool, and its input modules' rules in the room.
machine fw16; reset
r4=$(newroom 20261113-090000)
takumi hardware apply --root "$r4" >/dev/null 2>&1 && rc=0 || rc=$?
check "a Framework 16: framework-system, and its keyboard modules and LED matrix yours at the computer ($rc)" '[[ $rc -eq 0 ]] && grep -qx framework-system "$FAKE/installed" && grep -q "ATTRS{idVendor}==\"32ac\", ATTRS{idProduct}==\"0012|0013|0014|0018|0019\", MODE=\"0660\", TAG+=\"uaccess\"" "$r4/etc/udev/rules.d/90-takumi-hardware.rules" && grep -q "ATTRS{idProduct}==\"0020\"" "$r4/etc/udev/rules.d/90-takumi-hardware.rules"'

# --- What takumi doctor says.
machine surface; export TAKUMI_HW_ROOM=20261112-000000
doc=$(lib hw_doctor)
check "the doctor names fixes this system lacks" 'grep -q "^needs	Takumi has fixes for this computer that are not in this system yet (" <<< "$doc"'
check "missing firmware, with the package an update adds" 'grep -qx "needs	The Wi-Fi is missing firmware (mrvl/pcie8897_uapsta.bin, in linux-firmware-marvell): \"update\" adds it" <<< "$doc"'
machine thinkpad
printf '%s\n' "Bluetooth: hci0: BCM: firmware Patch file not found, tried: 'brcm/BCM20702A1-0a5c-21e6.hcd'" "platform regulatory.0: Direct firmware load for regulatory.db failed with error -2" >> "$TAKUMI_HW_KERNEL_LOG"
fw=$(lib hw_firmware_missing)
check "a newer Wi-Fi firmware tried before an older one that loaded is not missing" '! grep -q iwlwifi <<< "$fw"'
check "Broadcom Bluetooth firmware is only in the AUR; the radio rules are wireless-regdb" 'grep -qx "brcm/BCM20702A1-0a5c-21e6.hcd	aur:broadcom-bt-firmware	Bluetooth" <<< "$fw" && grep -qx "regulatory.db	wireless-regdb	The Wi-Fi" <<< "$fw"'
: > "$TAKUMI_HW_KERNEL_LOG"; export TAKUMI_HW_ROOM=20261110-080000
check "all in place: one ok line" '[[ "$(lib hw_doctor)" == "ok	Takumi'"'"'s fixes for this computer are in place, and no firmware is missing" ]]'

# --- The two hooks: the setup disc's install and the room an update builds.
check "the setup disc applies the fixes after its packages are reachable in the target, before the installer" '[[ $(grep -n "takumi hardware apply --root \"\$target\"" commands/setup/install | cut -d: -f1) -gt $(grep -n "setup-pacman.conf\"$" commands/setup/install | head -n 1 | cut -d: -f1) && $(grep -n "takumi hardware apply" commands/setup/install | cut -d: -f1) -lt $(grep -n "install/run.sh" commands/setup/install | cut -d: -f1) ]]'
check "an update applies them inside the room it builds, and a failure never stops it" 'grep -q "^takumi hardware apply --root \"\$r\" || " commands/room/upgrade'

echo "   $n hardware checks against fake computers"
exit $status
