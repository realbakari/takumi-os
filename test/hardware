# --- The data: every fix reads, and names only what Takumi knows.
fixes=$(lib hw_fixes "$repo/default/hardware")
check "every fix file reads" '[[ -n "$fixes" ]] && [[ -z "$(jq -r "select(.error) | .file" <<< "$fixes")" ]]'
check "there are at least 30 fixes" '[[ $(jq -s length <<< "$fixes") -ge 30 ]]'
check "no fix has a key Takumi does not know" '[[ -z "$(jq -r "select((.extra | length) > 0) | .id" <<< "$fixes")" ]]'
check "parts and works are words Takumi knows" '[[ -z "$(jq -r "select((.part | IN(\"graphics\",\"wifi\",\"wired\",\"bluetooth\",\"camera\",\"sound\",\"fingerprint\",\"touchpad\",\"processor\",\"computer\") | not) or (.works | IN(\"yes\",\"partly\",\"no\") | not)) | .id" <<< "$fixes")" ]]'
check "match and apply keys are ones Takumi knows" '[[ -z "$(jq -r "select(((.match | keys) - [\"pci\",\"pci_class\",\"usb\",\"arch\",\"laptop\",\"virtual\",\"cpu_vendor\",\"cpu_family\",\"cpu_model\",\"dt_compatible\",\"kernel_log\",\"dmi_vendor\",\"dmi_product\",\"dmi_family\",\"dmi_version\",\"dmi_board\",\"dmi_board_vendor\",\"dmi_chassis\"] | length) > 0 or ((.apply | keys) - [\"packages\",\"aur\",\"cmdline\",\"modprobe\",\"initramfs_modules\",\"udev\",\"services\",\"note\"] | length) > 0) | .id" <<< "$fixes")" ]]'
check "every fix matches on something and says what it does" '[[ -z "$(jq -r "select((.match | length) == 0 or (.apply.note // \"\") == \"\") | .id" <<< "$fixes")" ]]'
check "package names are names, and an AUR one is never installed" '[[ -z "$(jq -r "select(any((.apply.packages // [])[], (.apply.aur // [])[]; test(\"^[a-z0-9@._+-]+$\") | not) or ((.apply.packages // []) - ((.apply.packages // []) - (.apply.aur // [])) | length) > 0) | .id" <<< "$fixes")" ]]'
check "32-bit libraries are never all a fix installs (apply may leave them out)" '[[ -z "$(jq -r "select(((.apply.packages // []) | length) > 0 and all((.apply.packages // [])[]; startswith(\"lib32-\"))) | .id" <<< "$fixes")" ]]'
check "kernel options are single words, modprobe lines are options or blacklists, udev lines are rules" '[[ -z "$(jq -r "select(any((.apply.cmdline // [])[]; test(\"[[:space:]]\")) or any((.apply.modprobe // [])[]; test(\"^(options|blacklist|softdep) \") | not) or any((.apply.udev // [])[]; contains(\"==\") | not)) | .id" <<< "$fixes")" ]]'
check "early modules and services are names" '[[ -z "$(jq -r "select(any((.apply.initramfs_modules // [])[]; test(\"^[a-z0-9_]+$\") | not) or any((.apply.services // [])[]; test(\"[.](service|socket|timer)$\") | not)) | .id" <<< "$fixes")" ]]'
check "what a row says is short" '[[ -z "$(jq -r "select((.says | length) > 40) | .id" <<< "$fixes")" ]]'

