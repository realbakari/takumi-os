check "detect says why and on which device" '[[ "$(jq -c ".matches[] | select(.id == \"nvidia-open\") | [.why, .devices, .apply.cmdline]" <<< "$det")" == "[[\"pci 10de:2820\"],[\"pci:01:00.0\"],[\"nvidia_drm.modeset=1\",\"nvidia_drm.fbdev=1\"]]" ]]'
check "detect --all lists every fix without looking" '[[ "$(takumi hardware detect --all | jq ".matches | length")" == "$(jq -s length <<< "$fixes")" ]]'
takumi hardware detect --nope >/dev/null 2>&1 && rc1=0 || rc1=$?; takumi hardware detect --data "$t/none" >/dev/null 2>&1 && rc2=0 || rc2=$?
