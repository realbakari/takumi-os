if command -v node >/dev/null; then
  if out=$(node "$t/queue.js" "$cs" shell/Sources/Notices.qml 2>&1); then :; else echo "$out" | sed 's/^/notices: queue: /'; status=1; fi
  if out=$(node "$t/links.js" shell/Core/Notice.qml "$cs" 2>&1); then :; else echo "$out" | sed 's/^/notices: links: /'; status=1; fi
  queue_checks=$(grep -c '^ok("' "$0")
queue_checks=$((queue_checks + $(grep -c '^ok("' "$t/links.js")))
else
  echo "   (node not installed; the queue's logic not run here)"; queue_checks=0
fi

check "Notices.qml reads only what CoreState has" '[[ -z "$(grep -ohE "\bc\.[a-zA-Z_]+" shell/Sources/Notices.qml | sed "s/^c\.//" | sort -u | while read -r u; do grep -qx "$u" <<< "$defs" || echo "$u"; done)" ]]'
check "the keys move through waiting notices, and leave Super+Shift+Up and Down to windows" 'grep -qE "^    Mod\+Alt\+Page_Up .*\"notices\" \"previous\"; \}$" config/niri/takumi/defaults.kdl && grep -qE "^    Mod\+Alt\+Page_Down .*\"notices\" \"next\"; \}$" config/niri/takumi/defaults.kdl && grep -q "^    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }" config/niri/takumi/defaults.kdl && grep -q "function next(): void { noticesService.next(); }" shell/shell.qml && grep -q "function previous(): void { noticesService.previous(); }" shell/shell.qml'
check "a link opens only through gio, never a command a message chose" '[[ $(grep -c "execDetached" shell/Core/Notice.qml) -eq 1 ]] && grep -q "execDetached(\[\"gio\", \"open\", href\])" shell/Core/Notice.qml && grep -q "onLinkActivated: link => notice.openLink(link)" shell/Core/Notice.qml'
check "the Core marks dictation, a running timer and remote help, from what the commands leave" 'grep -q "takumi-voice" shell/Sources/Poll.qml && grep -q "reminders.tsv" shell/Sources/Poll.qml && grep -q "takumi-remote" shell/Sources/Poll.qml && grep -q "visible: rest.poll.dictating" shell/Core/Rest.qml && grep -q "visible: rest.poll.remote > 0" shell/Core/Rest.qml && grep -q "visible: timerLeft.secs > 0" shell/Core/Rest.qml'
