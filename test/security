#!/usr/bin/env bash
# Contract checks for signing in and starting safely (commands/password/main, commands/security/*,
# commands/disk/tpm, commands/palette/security, lib/security.sh and the password and TPM parts of lib/disk.sh)
# against fake tools first in PATH that keep what they were told: sudo, unix_chkpwd, chpasswd, cryptsetup,
# systemd-cryptenroll, fprintd, busctl, sbctl and the firmware's variables. The conversations' lines in the Core,
# the exit codes, the files before and after, and that no password reaches any command's arguments. Runs on
# bash 3.2 with jq.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
command -v jq >/dev/null || { echo "   (jq not installed; security checks skipped)"; exit 0; }
repo=$PWD; status=0
t=$(mktemp -d "${TMPDIR:-/tmp}/takumi-security.XXXXXX"); trap 'rm -rf "${t:?}"' EXIT
export T=$t CALLS=$t/calls HOME=$t/home XDG_RUNTIME_DIR=$t/run
mkdir -p "$t/bin" "$HOME" "$XDG_RUNTIME_DIR" "$t/commands/room"
export PATH="$t/bin:$repo/bin:$PATH"
export TAKUMI_COMMANDS="$t/commands:$repo/commands"   # fake takumi commands go in front of the real ones
export TAKUMI_PAM_DIR=$t/pam.d TAKUMI_FPRINT_DIR=$t/fprint TAKUMI_LID=$t/lid TAKUMI_EFIVARS=$t/efivars TAKUMI_SBCTL_DIR=$t/sbctl \
  TAKUMI_USR_LIB=$t/usr/lib TAKUMI_FWUPD_CONF=$t/fwupd.conf TAKUMI_TPM=$t/tpm TAKUMI_KERNEL_CMDLINE=$t/cmdline \
  TAKUMI_GREETD_CONFIG=$t/greetd.toml TAKUMI_PASSWD=$t/passwd TAKUMI_FINGER_WAIT=1 TAKUMI_VENDOR_PAM_DIR=$t/vendor-pam
fake() { printf '#!/usr/bin/env bash\n%s\n' "$2" > "$t/bin/$1"; chmod +x "$t/bin/$1"; }
rec='printf "%s %s\n" "$(basename "$0")" "$*" >> "$CALLS"'

# --- The fakes. Root is FAKE_ROOT, set by the fake sudo for what it runs.
fake id 'case "$1" in -u) if [[ -n "${FAKE_ROOT:-}" ]]; then echo 0; else echo 501; fi ;; -un) echo ana ;; -nG) cat "$T/groups" ;; *) exec /usr/bin/id "$@" ;; esac'
# sudo -S reads its password from stdin's first line (unless $T/nopasswd), -A says why; then the command, as root.
fake sudo "$rec"'
ask=no
while [[ "${1:-}" == -* ]]; do
  case "$1" in -S) ask=yes ;; -p) shift ;; -A) echo "why ${TAKUMI_SUDO_WHY:-}" >> "$CALLS" ;; esac
  shift
done
if [[ $ask == yes && ! -f "$T/nopasswd" ]]; then IFS= read -r p || exit 1; [[ "$p" == "$(cat "$T/password")" ]] || exit 1; fi
export FAKE_ROOT=1 SUDO_USER=ana
exec "$@"'
fake setsid "$rec"'; [[ "${1:-}" == -w ]] && shift; exec "$@"'
fake unix_chkpwd "$rec"'; IFS= read -r -d "" p || true; [[ "$1" == ana && "$2" == nonull && "$p" == "$(cat "$T/password")" ]]'
fake chpasswd "$rec"'; IFS= read -r l || true; [[ -f "$T/chpasswd-fails" ]] && exit 1; [[ "${l%%:*}" == ana ]] || exit 1; printf "%s" "${l#*:}" > "$T/password"'
fake findmnt 'case "$*" in "-no SOURCE /") echo /dev/mapper/takumi ;; "-no OPTIONS /") echo "rw,noatime,subvol=/@rooms/20261108-093000" ;; *) exit 1 ;; esac'
fake lsblk 'if [[ -f "$T/unencrypted" ]]; then echo part; else echo crypt; fi'
fake bootctl "$rec"'; [[ "$1" == --print-esp-path ]] && echo "$T/esp"; exit 0'
fake systemctl "$rec"
fake mkinitcpio "$rec"
fake systemd-analyze 'if [[ -f "$T/no-tpm-libs" ]]; then printf "partial\n+firmware\n+driver\n+system\n+subsystem\n-libraries\n"; exit 1; fi
printf "yes\n+firmware\n+driver\n+system\n+subsystem\n+libraries\n"'
printf '#!/bin/sh\necho "takumi room kernel-sync" >> "$CALLS"\n' > "$t/commands/room/kernel-sync"; chmod +x "$t/commands/room/kernel-sync"
# The disk: a file per key slot in $T/slots holding what opens it, the tokens in $T/tokens.json.
cat > "$t/bin/cryptsetup" <<'FAKE'
#!/usr/bin/env bash
printf 'cryptsetup %s\n' "$*" >> "$CALLS"
key="" slot="" tid="" pos=()
while (( $# )); do
  case "$1" in
    --key-file=*) key=${1#--key-file=} ;;
    --key-slot) slot=$2; shift ;;
    --token-id) tid=$2; shift ;;
    --*) ;;
    *) pos+=("$1") ;;
  esac
  shift
done
secret() { if [[ "$1" == - ]]; then cat; else cat "$1"; fi; }
opens() {
  local f
  for f in "$T"/slots/*; do
    [[ -f "$f" ]] || continue
    if [[ -n "${2:-}" && "${f##*/}" != "$2" ]]; then continue; fi
    [[ "$(cat "$f")" == "$1" ]] && return 0
  done
  return 1
}
case "${pos[0]}" in
  status) [[ -f "$T/unencrypted" ]] && exit 4; echo "  device:  /dev/vda2" ;;
  open) opens "$(secret "$key")" "$slot" || exit 2 ;;
  luksChangeKey) old=$(secret "$key"); new=$(cat "${pos[2]}"); opens "$old" 0 || exit 2; printf '%s' "$new" > "$T/slots/0" ;;
  luksUUID) echo 1111-2222 ;;
  luksDump) jq -cn --argjson tokens "$(cat "$T/tokens.json")" --arg slots "$(ls "$T/slots" | tr '\n' ' ')" \
              '{keyslots: ($slots | split(" ") | map(select(. != "")) | map({key: ., value: {}}) | from_entries), tokens: $tokens}' ;;
  luksKillSlot) opens "$(secret "$key")" || exit 2; rm -f "$T/slots/${pos[2]}" ;;
  token) [[ "${pos[1]}" == remove ]] || exit 1
         jq -c --arg id "$tid" 'del(.[$id])' "$T/tokens.json" > "$T/t.json" && mv "$T/t.json" "$T/tokens.json" ;;
  *) exit 1 ;;
esac
exit 0
FAKE
# systemd-cryptenroll: a new slot and a systemd-tpm2 token; --wipe-slot=tpm2 takes the earlier ones once it is in.
cat > "$t/bin/systemd-cryptenroll" <<'FAKE'
#!/usr/bin/env bash
printf 'systemd-cryptenroll %s\n' "$*" >> "$CALLS"
key="" wipe=no dev=""
for a in "$@"; do
  case "$a" in --unlock-key-file=*) key=$(cat "${a#--unlock-key-file=}") ;; --wipe-slot=tpm2) wipe=yes ;; --*) ;; *) dev=$a ;; esac
done
[[ -f "$T/tpm-fails" ]] && exit 1
ok=no; for f in "$T"/slots/*; do [[ -f "$f" && "$(cat "$f")" == "$key" ]] && ok=yes; done
[[ $ok == yes && "$dev" == /dev/vda2 ]] || exit 1
old=$(jq -r 'to_entries[] | select(.value.type == "systemd-tpm2") | .key' "$T/tokens.json")
n=0; while [[ -e "$T/slots/$n" ]]; do n=$((n + 1)); done
echo "sealed to the chip" > "$T/slots/$n"
id=0; while jq -e --arg id "$id" 'has($id)' "$T/tokens.json" >/dev/null; do id=$((id + 1)); done
jq -c --arg id "$id" --arg s "$n" '. + {($id): {type: "systemd-tpm2", keyslots: [$s]}}' "$T/tokens.json" > "$T/t.json" && mv "$T/t.json" "$T/tokens.json"
if [[ $wipe == yes ]]; then
  for o in $old; do
    for s in $(jq -r --arg id "$o" '.[$id].keyslots[]' "$T/tokens.json"); do rm -f "$T/slots/$s"; done
    jq -c --arg id "$o" 'del(.[$id])' "$T/tokens.json" > "$T/t.json" && mv "$T/t.json" "$T/tokens.json"
  done
fi
FAKE
# fprintd: the enrolled fingers in $T/fingers; fprintd-enroll says what $T/enroll lists ("hang" stays quiet).
cat > "$t/bin/fprintd-list" <<'FAKE'
#!/usr/bin/env bash
printf 'fprintd-list %s\n' "$*" >> "$CALLS"
if [[ -f "$T/no-reader" ]]; then echo "No devices available"; exit 1; fi
echo "found 1 devices"; echo "Device at /net/reactivated/Fprint/Device/0"; echo "Using device /net/reactivated/Fprint/Device/0"
if [[ -s "$T/fingers" ]]; then
  echo "Fingerprints for user $1 on Fake Sensor (press):"
  n=0; while IFS= read -r f; do echo " - #$n: $f"; n=$((n + 1)); done < "$T/fingers"
else
  echo "User $1 has no fingers enrolled for Fake Sensor."
fi
FAKE
cat > "$t/bin/fprintd-enroll" <<'FAKE'
#!/usr/bin/env bash
printf 'fprintd-enroll %s\n' "$*" >> "$CALLS"
finger=right-index-finger; [[ "$1" == -f ]] && finger=$2
if [[ -f "$T/busy" ]]; then echo "failed to claim device: Device was already claimed"; exit 1; fi
echo "Using device /net/reactivated/Fprint/Device/0"; echo "Enrolling $finger finger."
while IFS= read -r l; do
  if [[ "$l" == hang ]]; then sleep 3; continue; fi
  echo "Enroll result: $l"
  if [[ "$l" == enroll-completed ]]; then echo "$finger" >> "$T/fingers"; exit 0; fi
done < "$T/enroll"
exit 1
FAKE
fake fprintd-delete "$rec"'; : > "$T/fingers"; echo "Fingerprints of user $1 deleted on Fake Sensor"'
fake busctl "$rec"'; case "$*" in *num-enroll-stages*) cat "$T/stages" ;; *scan-type*) echo "s \"$(cat "$T/scan")\"" ;; *) exit 1 ;; esac'
cat > "$t/bin/sbctl" <<'FAKE'
#!/usr/bin/env bash
printf 'sbctl %s\n' "$*" >> "$CALLS"
case "$1" in
  create-keys) mkdir -p "$TAKUMI_SBCTL_DIR/keys/db"; : > "$TAKUMI_SBCTL_DIR/keys/db/db.key" ;;
  enroll-keys) [[ -f "$T/enroll-refused" ]] && exit 1; [[ -f "$TAKUMI_SBCTL_DIR/keys/db/db.key" ]] || exit 1 ;;
  sign) for a in "$@"; do last=$a; done; [[ -f "$last" ]] || exit 1 ;;
esac
exit 0
FAKE
# python3: gnome-keyring's own D-Bus change, given the code; the two passwords come on stdin and the login keyring
# ($T/keyring) takes the new one when the old one opens it.
cat > "$t/bin/python3" <<'FAKE'
#!/usr/bin/env bash
printf 'python3 %s %s\n' "$1" "$(printf '%s' "${2:-}" | tr '\n' ' ')" >> "$CALLS"
IFS= read -r old || true; IFS= read -r new || true
[[ -f "$T/no-keyring" ]] && exit 3
[[ "$old" == "$(cat "$T/keyring")" ]] || exit 4
printf '%s' "$new" > "$T/keyring"
FAKE
chmod +x "$t/bin/"*

pw='old pass:1' new='Brand new 7' code=123456-234567-345678-456789-567890-678901
efivar() {  # <name> <0|1>: four bytes of attributes, then the value
  if [[ "$2" == 1 ]]; then printf '\007\000\000\000\001'; else printf '\007\000\000\000\000'; fi > "$T/efivars/$1-8be4df61-93ca-11d2-aa0d-00e098032b8c"
}
sudo_pam=$(printf '%s\n' '#%PAM-1.0' 'auth		include		system-auth' 'account		include		system-auth' 'session		include		system-auth')
polkit_pam=$(printf '%s\n' '#%PAM-1.0' '' 'auth       include      system-auth' 'account    include      system-auth' 'password   include      system-auth' 'session    include      system-auth')
greetd=$(printf '%s\n' '[terminal]' 'vt = 1' '' '[default_session]' 'command = "takumi greeter"' 'user = "greeter"' '' '[initial_session]' 'command = "takumi session start"' 'user = "ana"')
reset() {
  rm -rf "${T:?}"/slots "$T"/pam.d "$T"/vendor-pam "$T"/fprint "$T"/lid "$T"/efivars "$T"/sbctl "$T"/usr "$T"/tpm "$T"/esp
  rm -f "$T"/unencrypted "$T"/nopasswd "$T"/no-sudo "$T"/chpasswd-fails "$T"/no-reader "$T"/busy "$T"/tpm-fails "$T"/no-tpm-libs "$T"/enroll-refused
  mkdir -p "$T/slots" "$T/pam.d" "$T/vendor-pam" "$T/fprint" "$T/lid/LID0" "$T/efivars" "$T/tpm/tpm0" "$T/esp/loader" "$T/esp/EFI/systemd" "$T/esp/EFI/BOOT" \
    "$T/esp/takumi/20261108-093000" "$T/esp/takumi/20261101-201512" "$T/usr/lib/systemd/boot/efi" "$T/usr/lib/fwupd/efi"
  printf '%s' "$pw" > "$T/password"; printf '%s' "$pw" > "$T/slots/0"; printf '%s' "$pw" > "$T/keyring"; rm -f "$T/no-keyring"
  printf '%s' "$code" > "$T/slots/1"; printf '%s' "${code//-/}" > "$T/slots/2"
  echo '{"0":{"type":"takumi-recovery","keyslots":["1","2"]}}' > "$T/tokens.json"
  echo "ana wheel" > "$T/groups"
  printf '%s\n' "$sudo_pam" > "$T/pam.d/sudo"; printf '%s\n' "$polkit_pam" > "$T/pam.d/polkit-1"; : > "$T/pam.d/takumi-lock-finger"
  echo "state:      open" > "$T/lid/LID0/state"
  efivar SecureBoot 1; efivar SetupMode 0
  echo 2 > "$T/tpm/tpm0/tpm_version_major"
  echo "rd.luks.name=1111-2222=takumi root=/dev/mapper/takumi rw quiet splash" > "$T/cmdline"
  printf '%s\n' "$greetd" > "$T/greetd.toml"
  printf '%s\n' "root:x:0:0::/root:/bin/bash" "ana:x:1000:1000:Ana:/home/ana:/bin/bash" > "$T/passwd"
  printf '%s\n' "default takumi-20261108-093000.conf" "timeout 0" > "$T/esp/loader/loader.conf"
  printf '%s\n' "[fwupd]" "DisabledPlugins=test" "" "[redfish]" "IpmiDisableCreateUser=False" > "$T/fwupd.conf"
  for f in "$T/usr/lib/systemd/boot/efi/systemd-bootx64.efi" "$T/usr/lib/fwupd/efi/fwupdx64.efi" "$T/esp/EFI/systemd/systemd-bootx64.efi" \
           "$T/esp/EFI/BOOT/BOOTX64.EFI" "$T/esp/takumi/20261108-093000/linux" "$T/esp/takumi/20261101-201512/linux"; do echo program > "$f"; done
  : > "$CALLS"; : > "$T/fingers"; echo "i 5" > "$T/stages"; echo press > "$T/scan"; : > "$T/enroll"
}
check() { if eval "$2"; then :; else echo "security: $1"; status=1; fi; }
talk() { local answers=$1; shift; printf '%b' "$answers" | TAKUMI_CORE=1 "$@" 2>&1; echo "rc=$?"; }
said_lines() { tr '\n' '|' <<< "$1"; }
no_secret() { ! grep -qF -e "$pw" -e "$new" -e "$code" -e "older disk pw" "$CALLS"; }
rows() { commands/palette/security "$1"; }

# --- takumi password
reset
said=$(talk "$pw\n$new\n$new\n" commands/password/main)
check "the conversation: your password, a new one twice, done ($(said_lines "$said"))" \
  '[[ "$(said_lines "$said")" == "secret Your password|secret New password|secret Type it again|note Changing your password…|done Your password is changed, for logging in and for the disk|rc=0|" ]]'
check "the account and key slot 0 both open with the new password" '[[ "$(cat "$T/password")" == "$new" && "$(cat "$T/slots/0")" == "$new" ]]'
check "the recovery code still opens the disk, with and without dashes, and keeps its token" \
  '[[ "$(cat "$T/slots/1")" == "$code" && "$(cat "$T/slots/2")" == "${code//-/}" && "$(jq -c ".[\"0\"]" "$T/tokens.json")" == "{\"type\":\"takumi-recovery\",\"keyslots\":[\"1\",\"2\"]}" ]]'
check "slot 0 is changed in place, the old password from a pipe" 'grep -q "^cryptsetup luksChangeKey --batch-mode --key-slot 0 --key-file=/dev/fd/[0-9]* /dev/vda2 /dev/fd/[0-9]*$" "$CALLS"'
check "sudo reads the typed password, with the terminal taken away" 'grep -q "^setsid -w sudo -k -S -p  .*/commands/password/main --root change$" "$CALLS"'
check "no password in any command's arguments" 'no_secret'
reset
said=$(talk "wrong one\n$pw\n$new\n$new\n" commands/password/main)
check "a wrong password shakes and is asked again" '[[ "$(head -n 3 <<< "$said" | tr "\n" "|")" == "secret Your password|wrong That password did not work|secret Your password|" && "$said" == *"rc=0" ]]'
reset
said=$(talk 'a\nb\nc\n' commands/password/main)
check "three wrong passwords: exit 3 and nothing changed" '[[ "$said" == *"rc=3" && "$(cat "$T/password")" == "$pw" && "$(cat "$T/slots/0")" == "$pw" ]] && ! grep -q "^chpasswd" "$CALLS"'
reset
said=$(talk "$pw\nshort\n$pw\n$new\nother one\n$new\n$new\n" commands/password/main)
check "too short, the same one, two that differ: each asked again" \
  '[[ "$(grep "^wrong" <<< "$said" | tr "\n" "|")" == "wrong At least six characters|wrong That is your password already|wrong The two are not the same|" && "$said" == *"rc=0" && "$(cat "$T/password")" == "$new" ]]'
reset; touch "$T/unencrypted"
said=$(talk "$pw\n$new\n$new\n" commands/password/main)
check "a disk that is not encrypted: the account alone" \
  '[[ "$(tail -n 2 <<< "$said" | tr "\n" "|")" == "done Your password is changed|rc=0|" && "$(cat "$T/password")" == "$new" ]] && ! grep -q "luksChangeKey" "$CALLS"'
reset; printf '%s' "older disk pw" > "$T/slots/0"
said=$(talk "$pw\nno\n$new\n$new\n" commands/password/main)
check "a disk with an earlier password: asked, and kept when you say no" \
  '[[ "$said" == *"note The disk still opens with an earlier password"*"confirm Change the disk'"'"'s password to the new one too?"*"done Your password is changed. The disk still opens with its earlier password"*"rc=0" ]] && [[ "$(cat "$T/slots/0")" == "older disk pw" && "$(cat "$T/password")" == "$new" ]]'
reset; printf '%s' "older disk pw" > "$T/slots/0"
said=$(talk "$pw\nyes\nolder disk pw\n$new\n$new\n" commands/password/main)
check "...and changed with its own password when you say yes" '[[ "$said" == *"done Your password is changed, for logging in and for the disk"*"rc=0" && "$(cat "$T/slots/0")" == "$new" ]] && no_secret'
reset; printf '%s' "older disk pw" > "$T/slots/0"
said=$(talk "$pw\nyes\nx\ny\nz\n" commands/password/main)
check "three wrong disk passwords: exit 4, nothing changed" '[[ "$said" == *"wrong That is not the disk'"'"'s password"*"rc=4" && "$(cat "$T/slots/0")" == "older disk pw" && "$(cat "$T/password")" == "$pw" ]]'
reset; touch "$T/chpasswd-fails"
said=$(talk "$pw\n$new\n$new\n" commands/password/main)
check "the account refuses: the disk is put back and it says so" '[[ "$said" == *"Your password did not change."*"rc=1" && "$(cat "$T/slots/0")" == "$pw" && "$(cat "$T/password")" == "$pw" ]]'
reset; touch "$T/nopasswd"
said=$(talk "$pw\n$new\n$new\n" commands/password/main)
check "with a sudo that asks nothing, the answers still line up" '[[ "$said" == *"rc=0" && "$(cat "$T/slots/0")" == "$new" && "$(cat "$T/password")" == "$new" ]]'
reset; echo ana > "$T/groups"
said=$(talk "$pw\n" commands/password/main)
check "an account that is not an administrator: said plainly" '[[ "$said" == *"Changing your password here needs an administrator account."*"rc=1" ]]'
check "the root part refuses to run as anyone else" '! printf "%s\n" "$pw" | commands/password/main --root check >/dev/null 2>&1'

# --- The login keyring follows the password
reset
said=$(talk "$pw\n$new\n$new\n" commands/password/main)
check "the login keyring takes the new password too, through gnome-keyring's own method, the passwords on stdin" \
  '[[ "$(cat "$T/keyring")" == "$new" && "$said" == *"rc=0" ]] && grep -q "^python3 .*ChangeWithMasterPassword" "$CALLS" && no_secret'
reset; printf '%s' "another keyring pw" > "$T/keyring"
said=$(talk "$pw\n$new\n$new\n" commands/password/main)
check "a keyring locked with another password keeps it, and the Core says so" \
  '[[ "$said" == *"note The login keyring still opens with its earlier password"*"done Your password is changed, for logging in and for the disk"*"rc=0" && "$(cat "$T/keyring")" == "another keyring pw" ]]'
reset; touch "$T/no-keyring"
said=$(talk "$pw\n$new\n$new\n" commands/password/main)
check "no login keyring: nothing said about it" '[[ "$said" != *keyring* && "$said" == *"rc=0" ]]'
reset; touch "$T/chpasswd-fails"
said=$(talk "$pw\n$new\n$new\n" commands/password/main)
check "the account refuses: the keyring is not touched" '[[ "$(cat "$T/keyring")" == "$pw" && "$said" == *"rc=1" ]] && ! grep -q "^python3" "$CALLS"'

# --- The login keyring at the login screen, and ten tries (lib/security.sh as 27-security.sh runs it)
greetd_pam=$(printf '%s\n' '#%PAM-1.0' '' 'auth       required     pam_securetty.so' 'auth       requisite    pam_nologin.so' 'auth       include      system-local-login' 'account    include      system-local-login' 'session    include      system-local-login')
reset; printf '%s\n' "$greetd_pam" > "$T/pam.d/greetd"
out=$(. lib/security.sh; security_keyring_pam on)
check "greetd's file: Takumi's lines at its end, the rest as it was" \
  '[[ "$(head -n 7 "$T/pam.d/greetd")" == "$greetd_pam" && "$(sed -n 8p "$T/pam.d/greetd")" == "# takumi-keyring: begin"* && "$(sed -n 9p "$T/pam.d/greetd")" == "auth"*"optional"*"pam_gnome_keyring.so" && "$(sed -n 11p "$T/pam.d/greetd")" == "session"*"optional"*"pam_gnome_keyring.so auto_start" && "$(sed -n 12p "$T/pam.d/greetd")" == "# takumi-keyring: end" && "$out" == *"in $T/pam.d/greetd" ]]'
check "the greeter's own account starts no keyring" '[[ "$(sed -n 10p "$T/pam.d/greetd")" == "session"*"pam_succeed_if.so quiet user = greeter" ]]'
before=$(cat "$T/pam.d/greetd"); out=$(. lib/security.sh; security_keyring_pam on)
check "on twice: one set of lines, nothing written" '[[ "$(cat "$T/pam.d/greetd")" == "$before" && -z "$out" ]]'
check "it knows when it is on" '(. lib/security.sh; security_keyring_pam_is_on)'
(. lib/security.sh; security_keyring_pam off) >/dev/null
check "off: greetd's file as it was" '[[ "$(cat "$T/pam.d/greetd")" == "$greetd_pam" ]]'
reset; printf '%s\n' "$greetd_pam" > "$T/vendor-pam/greetd"
(. lib/security.sh; security_keyring_pam on) >/dev/null
check "a greetd file in /usr/lib/pam.d: a copy with the lines in /etc/pam.d" '[[ "$(head -n 7 "$T/pam.d/greetd")" == "$greetd_pam" && "$(cat "$T/vendor-pam/greetd")" == "$greetd_pam" ]] && grep -q "^# takumi-keyring: begin" "$T/pam.d/greetd"'
(. lib/security.sh; security_keyring_pam off) >/dev/null
check "...and off takes the copy away" '[[ ! -e "$T/pam.d/greetd" ]]'
reset
check "no greetd: nothing written" '(. lib/security.sh; security_keyring_pam on) && [[ ! -e "$T/pam.d/greetd" ]]'
stock=$(printf '%s\n' '# Configuration for locking the user after multiple failed' '# authentication attempts.' '#' '# The directory where the user files with the failure records are kept.' '# dir = /var/run/faillock' '#' '# Deny access if the number of consecutive authentication failures' '# for this user during the recent interval exceeds n tries.' '# The default is 3.' '# deny = 3' '#' '# The access will be re-enabled after n seconds after the lock out.' '# The default is 600 (10 minutes).' '# unlock_time = 600' '#' '# fail_interval = 900')
printf '%s\n' "$stock" > "$t/faillock.conf"
out=$(TAKUMI_FAILLOCK_CONF=$t/faillock.conf bash -c '. lib/security.sh; security_faillock etc/security/faillock.conf')
check "faillock: ten tries and two minutes in place of pam's commented defaults, every other line kept" \
