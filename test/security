check "--check: 0 with a finger, the Lock's file and the lid open" 'commands/security/fingerprint --check'
echo "state:      closed" > "$T/lid/LID0/state"
check "--check: not with the lid closed" '! commands/security/fingerprint --check'
check "finger-ready: not with the lid closed" '! PAM_SERVICE=polkit-1 commands/security/finger-ready'
echo "state:      open" > "$T/lid/LID0/state"
check "finger-ready: sudo at a terminal asks for a finger" 'PAM_SERVICE=sudo PAM_TTY=/dev/pts/0 commands/security/finger-ready'
check "finger-ready: sudo without a terminal (the Core) goes to the password" '! PAM_SERVICE=sudo PAM_TTY= commands/security/finger-ready'
check "finger-ready: polkit asks for a finger without a terminal" 'PAM_SERVICE=polkit-1 PAM_TTY= commands/security/finger-ready'
mkdir -p "$T/fprint/bob/x/0"; : > "$T/fprint/bob/x/0/7"; : > "$CALLS"
