check "the install step puts the Lock's finger file in place and keeps sudo's and polkit's lines current" \
  'grep -q "install -Dm644 \"\$TAKUMI_PATH/default/pam/takumi-lock-finger\" /etc/pam.d/takumi-lock-finger" install/steps/27-security.sh && grep -q "security_finger_pam on" install/steps/27-security.sh'
