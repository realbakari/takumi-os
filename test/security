printf 'W\000i\000n\000d\000o\000w\000s\000 \000B\000o\000o\000t\000 \000M\000a\000n\000a\000g\000e\000r\000' > "$T/efivars/Boot0000-8be4df61-93ca-11d2-aa0d-00e098032b8c"
said=$(talk 'no\n' commands/security/secure-boot)
