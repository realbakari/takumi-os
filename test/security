before=$(cat "$T/pam.d/sudo")
FAKE_ROOT=1 commands/security/fingerprint --root on >/dev/null
check "on twice: one set of lines" '[[ "$(cat "$T/pam.d/sudo")" == "$before" && $(grep -c "^# takumi-fingerprint: begin" "$T/pam.d/sudo") -eq 1 ]]'
check "the state in words" '[[ "$(commands/security/fingerprint)" == "Fingerprint unlock is on: 1 finger" ]]'
: > "$CALLS"; echo "i -1" > "$T/stages"; echo swipe > "$T/scan"; printf '%s\n' enroll-stage-passed enroll-swipe-too-short enroll-completed > "$T/enroll"
said=$(talk "" commands/security/fingerprint on)
check "a second finger: the next label, a swipe reader, no count when the reader gives none ($(said_lines "$said"))" \
