  '[[ "$(jq -c "[.title, .subtitle, .glyph, .kind, .converse, .risk, .run]" <<< "$r")" == "[\"Unlock with your finger\",\"Touch the sensor instead of typing your password\",\"finger\",\"Security\",true,1,[\"takumi\",\"security\",\"fingerprint\",\"on\"]]" ]]'
