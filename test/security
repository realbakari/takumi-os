rm -rf "$T/fprint/bob"; echo right-index-finger > "$T/fingers"
said=$(talk "" commands/security/fingerprint off)
check "off: the last prints go, and both files are back as they were" '[[ "$(cat "$T/pam.d/sudo")" == "$sudo_pam" && "$(cat "$T/pam.d/polkit-1")" == "$polkit_pam" && "$said" == *"rc=0" ]]'
said=$(talk "" commands/security/fingerprint off)
check "off again: already off" '[[ "$said" == *"done Fingerprint unlock is already off"* ]]'
check "--check: not without a finger" '! commands/security/fingerprint --check'
reset; echo enroll-duplicate > "$T/enroll"
said=$(talk "" commands/security/fingerprint on)
check "a finger already known: exit 4, in words" '[[ "$said" == *"That finger is already known. Try another finger."*"rc=4" ]] && ! grep -q takumi-fingerprint "$T/pam.d/sudo"'
reset; echo hang > "$T/enroll"
said=$(talk "" commands/security/fingerprint on)
check "nobody touches the sensor: exit 3, nothing saved" '[[ "$said" == *"Nothing was saved: the sensor was not touched for a while."*"rc=3" && ! -s "$T/fingers" ]]'
reset; touch "$T/busy"
said=$(talk "" commands/security/fingerprint on)
check "another program has the reader: exit 4, in words" '[[ "$said" == *"The sensor is in use by something else. Try again in a moment."*"rc=4" ]]'
reset; printf '%s\n' '#%PAM-1.0' 'auth required pam_unix.so' > "$T/pam.d/sudo"
FAKE_ROOT=1 commands/security/fingerprint --root on >/dev/null 2>&1
check "a PAM file without a system-auth line is left as it is" '[[ "$(cat "$T/pam.d/sudo")" == "$(printf "%s\n" "#%PAM-1.0" "auth required pam_unix.so")" ]] && grep -q takumi-fingerprint "$T/pam.d/polkit-1"'

reset; mv "$T/pam.d/polkit-1" "$T/vendor-pam/polkit-1"
FAKE_ROOT=1 commands/security/fingerprint --root on >/dev/null
