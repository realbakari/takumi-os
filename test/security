# --- takumi disk tpm and its rows
reset
check "off: the row offers it" '[[ "$(rows tpm | jq -c "[.title, .glyph, .risk, .run]")" == "[\"Open the disk by itself\",\"chip\",2,[\"takumi\",\"disk\",\"tpm\",\"on\"]]" ]]'
check "the state in words" '[[ "$(commands/disk/tpm)" == "The disk asks for your password when this computer starts" ]]'
said=$(talk "$pw\n" commands/disk/tpm on)
check "on: the conversation ($(said_lines "$said"))" \
  '[[ "$(said_lines "$said")" == "note The disk opens by itself on this computer unless someone changes how it starts; your password and recovery code still work|secret Your password|note Sealing a key to the chip and getting the start ready…|done The disk opens by itself on this computer now. The login screen asks for your password|rc=0|" ]]'
