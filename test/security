check "the Lock's password also opens the login keyring, after the login checks" '[[ "$(grep -v "^#" default/pam/takumi-lock)" == "$(printf "%s\n" "auth include login" "auth optional pam_gnome_keyring.so")" ]]'
check "the install step adds the keyring to greetd's file and sets faillock" 'grep -q "security_keyring_pam on" install/steps/27-security.sh && grep -q "security_faillock" install/steps/27-security.sh'
check "the Lock says how long it waits after ten wrong passwords" 'grep -q "minutes\\? left to unlock" shell/Lock/Lock.qml && grep -q "failText: root.lockout" shell/Lock/Lock.qml && grep -q "face.failText || \"Try again\"" shell/Parts/LockFace.qml'

echo "   $(grep -c '^check ' "$0") security checks against fake sudo, cryptsetup, fprintd and sbctl"
