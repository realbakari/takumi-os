  'grep -q "^systemd-cryptenroll --wipe-slot=tpm2 --tpm2-device=auto --tpm2-pcrs=7 --unlock-key-file=/dev/fd/[0-9]* /dev/vda2$" "$CALLS" && [[ "$(jq -c "[to_entries[] | select(.value.type == \"systemd-tpm2\") | .value.keyslots]" "$T/tokens.json")" == "[[\"3\"]]" ]]'
check "the password's slot and the recovery code's stay" '[[ "$(cat "$T/slots/0")" == "$pw" && "$(cat "$T/slots/1")" == "$code" && "$(cat "$T/slots/2")" == "${code//-/}" ]]'
check "the initramfs asks the chip first, every option kept" '[[ "$(cat "$T/cmdline")" == "rd.luks.name=1111-2222=takumi root=/dev/mapper/takumi rw quiet splash rd.luks.options=1111-2222=tpm2-device=auto" ]]'
check "the login screen asks: no session opens by itself" '! grep -q initial_session "$T/greetd.toml" && grep -q "^\[default_session\]$" "$T/greetd.toml"'
check "the boot menu's editor is off" '[[ "$(cat "$T/esp/loader/loader.conf")" == "$(printf "%s\n" "default takumi-20261108-093000.conf" "timeout 0" "editor no")" ]]'
check "the initramfs and this room's entry are made again" 'grep -q "^mkinitcpio -P$" "$CALLS" && grep -q "^takumi room kernel-sync$" "$CALLS"'
check "no password in any command's arguments" 'no_secret'
check "on: the row and the words say so" '[[ "$(rows tpm | jq -c "[.title, .run]")" == "[\"The disk opens by itself\",[\"takumi\",\"disk\",\"tpm\",\"off\"]]" && "$(commands/disk/tpm)" == "The disk opens by itself when this computer starts" ]]'
said=$(talk "$pw\n" commands/disk/tpm on)
check "on again: one sealed key, one option" '[[ "$said" == *"rc=0" && "$(jq -c "[to_entries[] | select(.value.type == \"systemd-tpm2\")] | length" "$T/tokens.json")" == 1 && $(grep -o "tpm2-device=auto" "$T/cmdline" | wc -l) -eq 1 && ! -e "$T/slots/3" ]]'
: > "$CALLS"
said=$(talk "$pw\n" commands/disk/tpm off)
check "off: the chip's key and the option go, the one-password start comes back" \
  '[[ "$said" == *"done The disk asks for your password at every start again"*"rc=0" ]] && [[ "$(jq -c "[to_entries[] | select(.value.type == \"systemd-tpm2\")] | length" "$T/tokens.json")" == 0 && "$(cat "$T/cmdline")" == "rd.luks.name=1111-2222=takumi root=/dev/mapper/takumi rw quiet splash" && "$(cat "$T/greetd.toml")" == "$greetd" ]] && grep -q "^takumi room kernel-sync$" "$CALLS"'
check "off: the password's slot and the recovery code's stay" '[[ "$(ls "$T/slots" | tr "\n" " ")" == "0 1 2 " && "$(cat "$T/slots/0")" == "$pw" ]] && no_secret'
reset; efivar SecureBoot 0
said=$(talk "$pw\n" commands/disk/tpm on)
check "Secure Boot off: refused, in words, before any password" '[[ "$(said_lines "$said")" == "Turn on Secure Boot first: without it, anyone could start this computer from a USB stick and the chip would open the disk for them.|rc=1|" ]] && ! grep -q "systemd-cryptenroll" "$CALLS"'
reset; rm -rf "$T/tpm/tpm0"
said=$(talk "$pw\n" commands/disk/tpm on)
check "no chip: said plainly, and no row" '[[ "$said" == *"This computer has no security chip (TPM), so the disk asks for your password at every start."*"rc=1" && -z "$(rows tpm)" ]]'
reset; echo 1 > "$T/tpm/tpm0/tpm_version_major"
said=$(talk "$pw\n" commands/disk/tpm on)
check "an old chip (TPM 1.2): said plainly" '[[ "$said" == *"TPM 1.2"*"rc=1" ]]'
reset; touch "$T/unencrypted"
said=$(talk "$pw\n" commands/disk/tpm on)
check "a disk that is not encrypted: said plainly, and no row" '[[ "$said" == *"This computer'"'"'s disk is not encrypted, so there is nothing for the chip to open."*"rc=1" && -z "$(rows tpm)" ]]'
reset
said=$(talk 'a\nb\nc\n' commands/disk/tpm on)
check "three wrong passwords: exit 3, nothing sealed" '[[ "$said" == *"rc=3" ]] && ! grep -q "systemd-cryptenroll" "$CALLS" && [[ "$(cat "$T/greetd.toml")" == "$greetd" ]]'
reset; printf '%s' "older disk pw" > "$T/slots/0"
said=$(talk "$pw\n" commands/disk/tpm on)
check "the disk opens with another password: said, and what to do" '[[ "$said" == *"The disk opens with a different password. Change your password first, then try again."*"rc=3" ]]'
reset; touch "$T/no-tpm-libs"
said=$(talk "$pw\n" commands/disk/tpm on)
check "the chip's software missing: named, and nothing changed" '[[ "$said" == *"(tpm2-tss)"*"rc=1" && "$(cat "$T/greetd.toml")" == "$greetd" ]] && ! grep -q "systemd-cryptenroll" "$CALLS"'
reset; touch "$T/tpm-fails"
said=$(talk "$pw\n" commands/disk/tpm on)
check "the chip refuses: the one-password start comes back" '[[ "$said" == *"The chip could not take a key. The disk still asks for your password."*"rc=1" && "$(cat "$T/greetd.toml")" == "$greetd" && "$(cat "$T/cmdline")" != *tpm2* ]]'

