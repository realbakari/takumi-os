#!/usr/bin/env bash
: <<'ABOUT'
summary: Change the firewall as root, then note what it lets in for the Core; run by takumi firewall through sudo
usage: allow <app> | deny <app> | on | off | note
risk: 1
sudo: yes
hidden: yes
ABOUT
set -euo pipefail
for l in /usr/share/takumi/lib "$(dirname "$(readlink -f "$0")")/../../lib"; do [[ -f "$l/firewall.sh" ]] && { . "$l/firewall.sh"; break; }; done
declare -F firewall_note >/dev/null || { echo "takumi: the firewall library is missing" >&2; exit 1; }

# takumi firewall allow, deny, on and off, and the installer, run this through sudo, so a change and the note the
# Core reads take one password. ufw writes its own files (/etc/ufw/user.rules and user6.rules, /etc/ufw/ufw.conf,
# /etc/default/ufw); the note is /etc/takumi/firewall (docs/firewall.md).
usage() { echo "usage: takumi firewall apply allow <app> | deny <app> | on | off | note" >&2; exit 2; }
must() { local out; out=$(LC_ALL=C "$@" 2>&1) || { [[ -z "$out" ]] || printf '%s\n' "$out" >&2; exit 1; }; }
firewall_installed || { echo "ufw is not installed" >&2; exit 1; }
case "${1:-}" in
  allow) [[ -n "${2:-}" ]] || usage; must ufw allow "$2" ;;
  deny)
    [[ -n "${2:-}" ]] || usage
    # Taking away a rule that is not there is no failure: the app is blocked either way.
    out=$(LC_ALL=C ufw delete allow "$2" 2>&1) || [[ "$out" == *non-existent* ]] || { printf '%s\n' "$out" >&2; exit 1; } ;;
  on)
    must ufw default deny incoming
    must ufw default allow outgoing
    must ufw --force enable
    systemctl enable ufw.service >/dev/null 2>&1 || echo "ufw is on now, but its service could not be enabled: it is off again after a restart" >&2 ;;
  off) must ufw disable ;;
  note) ;;
  *) usage ;;
esac
firewall_note || { echo "the Core's note of what the firewall lets in could not be written" >&2; exit 1; }
