#!/usr/bin/env bash
: <<'ABOUT'
summary: Make text bigger or smaller everywhere: the Core, apps and the terminal
usage: <10-20|bigger|smaller>
example: takumi font size 15
example: takumi font size bigger
risk: 0
ABOUT
set -euo pipefail
for l in /usr/share/takumi/lib "$(dirname "$(readlink -f "$0")")/../../lib"; do [[ -f "$l/font.sh" ]] && { . "$l/font.sh"; . "$l/display.sh"; break; }; done
declare -F font_apply >/dev/null && declare -F display_set_text >/dev/null || { echo "takumi: the Takumi libraries are missing" >&2; exit 1; }
# The same size takumi display text sets (lib/display.sh: the Core's font_size and GTK's text scale, 13 being
# as drawn), carried on to foot's font size. bigger and smaller walk the Core's steps: 11 13 15 17 20.
# Exit status: 0 set · 2 usage.
now=$(display_text_size)
case "${1:-}" in
  bigger|smaller) to=$(display_next "$display_text_sizes" "$now" "$1") ;;
  1[0-9]|20) to=$1 ;;
  *) echo "usage: takumi font size <10-20|bigger|smaller>" >&2; exit 2 ;;
esac
if [[ -z "$to" ]]; then
  [[ "$1" == bigger ]] && edge=big || edge=small
  takumi notice edit "Text is as $edge as it goes" >/dev/null 2>&1 || true; echo "Text is as $edge as it goes"; exit 0
fi
display_set_text "$to"
font_apply
takumi notice edit "Text size $to" "the Core and apps now, the terminal from its next window" >/dev/null 2>&1 || true
echo "Text size $to"
