#!/usr/bin/env bash
: <<'ABOUT'
summary: Lock the screen
example: takumi lock
risk: 0
title: Lock screen
words: lock away
glyph: lock
ABOUT
set -euo pipefail
# The shell's lock (shell/Lock). Falls back to swaylock if the shell is not answering.
if command -v qs >/dev/null && qs -c takumi ipc --any-display call lock lock >/dev/null 2>&1; then exit 0; fi
exec swaylock -f
