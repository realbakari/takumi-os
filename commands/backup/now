#!/usr/bin/env bash
: <<'ABOUT'
summary: Back up your home folder now, to the disk or the cloud chosen in setup
usage: [--auto]
example: takumi backup now
risk: 0
title: Back up now
words: backup backups back up now save copy time machine file history
glyph: drive
ABOUT
set -euo pipefail
# From the Core or a script, the backup runs in takumi-backup.service, so it outlives the Palette and never runs twice
# at once; at a terminal it runs here. --auto is that service's own run: every hour from takumi-backup.timer, or when
# the backup disk is plugged in, it backs up only on the charger and at most once an hour, unless a person asked for
# this one. Exit status: 0 backed up, or nothing to do yet · 1 the backup failed · 2 backups are not set up · 3 the
# disk is not plugged in. The last line says it in words. See docs/backup.md.
here=$(dirname "$(readlink -f "$0")")
for l in /usr/share/takumi/lib "$here/../../lib"; do [[ -f "$l/backup.sh" ]] && { . "$l/backup.sh"; . "$l/power.sh"; break; }; done
declare -F backup_load >/dev/null && declare -F power_source >/dev/null || { echo "takumi: the Takumi libraries are missing" >&2; exit 1; }
command -v jq >/dev/null || { echo "Backups need jq" >&2; exit 1; }

auto=no; [[ "${1:-}" == --auto ]] && auto=yes
backup_load
if [[ -z "$place_kind" ]]; then
  [[ $auto == yes ]] && exit 0
  echo "Backups are not set up. Type backup in the Core to choose a disk or a cloud."
  exit 2
fi
mkdir -p "$backup_state" "$backup_run"

if [[ $auto == no && ! -t 1 ]] && command -v systemctl >/dev/null; then
  : > "$backup_run/backup-asked"
  if systemctl --user start --no-block takumi-backup.service >/dev/null 2>&1; then echo "Backing up to $place_name"; exit 0; fi
  rm -f "$backup_run/backup-asked"   # no service manager to run it: back up here
fi
asked=yes
if [[ $auto == yes ]]; then
  if [[ -f "$backup_run/backup-asked" ]]; then rm -f "$backup_run/backup-asked"; else asked=no; fi
fi
tell() { if [[ $asked == yes ]]; then takumi notice "$@" >/dev/null 2>&1 || true; fi; }   # a person is waiting to hear

# A disk is waited for: no backup without it, and a word once a week when it has been away for seven days.
if [[ $place_kind == disk && -z "$(backup_disk "$place_disk")" ]]; then
  if [[ $asked == yes ]]; then
    tell usb "Plug in $place_name to back up" "" -1 6
    echo "Plug in $place_name to back up"
    exit 3
  fi
  if (( $(backup_age seen) >= 7 * 86400 && $(backup_age reminded) >= 7 * 86400 )); then
    takumi notice usb "Backup disk not seen for 7 days" "Plug in $place_name to back up" -1 10 >/dev/null 2>&1 || true
    backup_stamp reminded
  fi
  exit 0
fi
[[ $place_kind == disk ]] && backup_stamp seen

if [[ $asked == no ]]; then
  [[ "$(power_source)" == power ]] || exit 0                                     # on battery: the charger first
  last=$(backup_last when)
  (( $(date +%s) - ${last:-0} >= 50 * 60 )) || exit 0                            # once an hour is enough
fi

backup_lock || { [[ $asked == yes ]] && echo "A backup is already running"; exit 0; }
log="$backup_state/last-run.log"
finish() {
  rm -f "$backup_run/backup.json" "$backup_run/backup-summary"
  if [[ $backup_we_mounted == yes ]] && ! backup_restore_open; then backup_unmount "$place_disk"; fi
  backup_unlock
}
trap finish EXIT
trap 'exit 143' TERM INT

rc=0; backup_locate wait || rc=$?
if (( rc != 0 )); then
  if (( rc == 3 )); then said="Plug in $place_name to back up"; else said="$place_name could not be opened"; printf '%s\n' "$said" > "$backup_state/problem"; fi
  tell usb "$said" "" -1 6
  echo "$said"
  exit 3
fi
if ! backup_key_have; then
  said="Your keyring did not give the backup key"
  printf '%s\n' "$said" > "$backup_state/problem"
  takumi notice warn "Backups are waiting" "$said; set up backups again and type your key" -1 8 >/dev/null 2>&1 || true
  echo "$said"
  exit 1
fi

jq -cn --argjson pid $$ --argjson t "$(date +%s)" --arg p "$place_name" '{pid: $pid, started: $t, percent: 0, place: $p}' > "$backup_run/backup.json"
backup_excludes "$backup_run/backup-excludes"
tell drive "Backing up to $place_name" "keep working; it runs in the background" -1
: > "$log"; rm -f "$backup_run/backup-summary"

# restic speaks JSON lines: progress now and then, a summary at the end. Errors go to the log.
set +e
backup_restic backup "$HOME" --json --exclude-file "$backup_run/backup-excludes" --exclude-caches --exclude-if-present .nobackup \
    --skip-if-unchanged --retry-lock 2m 2>> "$log" |
  jq -R --unbuffered -r 'fromjson? | select(type == "object")
    | if .message_type == "status" then "status\t\(((.percent_done // 0) * 100) | floor)"
      elif .message_type == "summary" then "summary\t\(.total_bytes_processed // 0)\t\(.total_files_processed // 0)\t\(.snapshot_id // "")"
      else empty end' |
  while IFS=$'\t' read -r what a b c; do
    case "$what" in
      status) jq -c --argjson p "${a:-0}" '.percent = $p' "$backup_run/backup.json" > "$backup_run/backup.json.new" 2>/dev/null &&
                mv "$backup_run/backup.json.new" "$backup_run/backup.json" ;;
      summary) printf '%s\t%s\t%s\n' "$a" "$b" "$c" > "$backup_run/backup-summary" ;;
    esac
  done
codes=("${PIPESTATUS[@]}")
set -e
rc=${codes[0]}
if [[ -f "$backup_run/backup-asked" ]]; then asked=yes; rm -f "$backup_run/backup-asked"; fi   # someone asked while it ran

if (( rc == 0 || rc == 3 )) && [[ -s "$backup_run/backup-summary" ]]; then
  IFS=$'\t' read -r bytes files snap < "$backup_run/backup-summary"   # no snapshot when nothing changed
  jq -cn --argjson when "$(date +%s)" --argjson bytes "${bytes:-0}" --argjson files "${files:-0}" --arg snap "$snap" --arg p "$place_name" \
    '{when: $when, bytes: $bytes, files: $files, snapshot: $snap, place: $p}' > "$backup_state/last.json"
  rm -f "$backup_state/problem"
  (( rc == 3 )) && echo "Some files could not be read and were left out; restic named them above." >> "$log"
  # Like a time machine: every hour for a day, every day for a month, every week after that. The space that frees is
  # given back once a week, on the charger. Neither runs while the backups are open in Files.
  if ! backup_restore_open; then
    backup_restic forget --keep-within-hourly 1d --keep-within-daily 1m --keep-weekly unlimited >> "$log" 2>&1 || true
    if (( $(backup_age pruned) >= 7 * 86400 )) && [[ "$(power_source)" == power ]]; then
      backup_restic prune >> "$log" 2>&1 && backup_stamp pruned
    fi
  fi
  said="Backed up to $place_name · $(backup_size "${bytes:-0}")"
  tell drive "Backed up to $place_name" "$(backup_size "${bytes:-0}") of your home folder" -1
  echo "$said"
  exit 0
fi

said=$(backup_words "$rc" "$log")
before=$(cat "$backup_state/problem" 2>/dev/null || true)
printf '%s\n' "$said" > "$backup_state/problem"
if [[ $asked == yes ]]; then
  tell warn "$said" "the details are in ~/.local/state/takumi/backup/last-run.log" -1 10
elif [[ "$said" != "$before" ]] || (( $(backup_age said) >= 86400 )); then   # the same trouble is said once a day
  takumi notice warn "The backup did not finish" "$said" -1 10 >/dev/null 2>&1 || true
  backup_stamp said
fi
last=$(backup_last when)
if [[ $place_kind == cloud && $asked == no ]] && (( $(date +%s) - ${last:-0} >= 7 * 86400 && $(backup_age reminded) >= 7 * 86400 )); then
  takumi notice warn "Not backed up for 7 days" "$said" -1 10 >/dev/null 2>&1 || true
  backup_stamp reminded
fi
echo "$said"
exit 1
