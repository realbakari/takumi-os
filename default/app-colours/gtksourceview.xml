<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered by takumi theme render for GtkSourceView 5 (GNOME Text Editor, Builder). -->
<style-scheme id="takumi" _name="Takumi ({{name}})" version="1.0">
  <author>Takumi OS</author>
  <description>Follows the active Takumi theme and phase.</description>

  <color name="bg"      value="{{background}}"/>
  <color name="surface" value="{{surface}}"/>
  <color name="fg"      value="{{foreground}}"/>
  <color name="muted"   value="{{muted}}"/>
  <color name="accent"  value="{{accent}}"/>
  <color name="red"     value="{{red}}"/>
  <color name="yellow"  value="{{yellow}}"/>
  <color name="green"   value="{{green}}"/>
  <color name="cyan"    value="{{cyan}}"/>
  <color name="blue"    value="{{blue}}"/>
  <color name="magenta" value="{{magenta}}"/>

  <style name="text"                 foreground="fg" background="bg"/>
  <style name="selection"            foreground="bg" background="accent"/>
  <style name="cursor"               foreground="accent"/>
  <style name="current-line"         background="surface"/>
  <style name="current-line-number"  foreground="accent" background="surface" bold="true"/>
  <style name="line-numbers"         foreground="muted" background="bg"/>
  <style name="right-margin"         foreground="muted" background="surface"/>
  <style name="bracket-match"        foreground="bg" background="accent" bold="true"/>
  <style name="bracket-mismatch"     foreground="bg" background="red" bold="true"/>
  <style name="search-match"         foreground="bg" background="yellow"/>

  <style name="def:comment"          foreground="muted" italic="true"/>
  <style name="def:constant"         foreground="magenta"/>
  <style name="def:string"           foreground="green"/>
  <style name="def:character"        foreground="green"/>
  <style name="def:number"           foreground="yellow"/>
  <style name="def:floating-point"   foreground="yellow"/>
  <style name="def:boolean"          foreground="magenta"/>
  <style name="def:identifier"       foreground="cyan"/>
  <style name="def:function"         foreground="blue"/>
  <style name="def:statement"        foreground="accent" bold="true"/>
  <style name="def:keyword"          foreground="accent" bold="true"/>
  <style name="def:operator"         foreground="cyan"/>
  <style name="def:type"             foreground="yellow"/>
  <style name="def:preprocessor"     foreground="magenta"/>
  <style name="def:special-char"     foreground="cyan"/>
  <style name="def:heading"          foreground="accent" bold="true"/>
  <style name="def:emphasis"         italic="true"/>
  <style name="def:strong-emphasis"  bold="true"/>
  <style name="def:link-destination" foreground="blue" underline="single"/>
  <style name="def:error"            foreground="red" underline="error"/>
  <style name="def:warning"          foreground="yellow" underline="single"/>
  <style name="def:note"             foreground="cyan" bold="true"/>
  <style name="def:inserted"         foreground="green"/>
  <style name="def:deleted"          foreground="red"/>
  <style name="def:changed"          foreground="yellow"/>
</style-scheme>
