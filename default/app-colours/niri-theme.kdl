// rendered by takumi theme render
layout {
    // Directional optical light catch on the focused column rather than a flat neon outline.
    focus-ring {
        active-gradient from="{{accent}}d0" to="{{accent}}44" angle=135
        inactive-color "{{muted}}38"
    }
    shadow { color "#00000078"; }
}
// The focus ring is drawn as a ring, never as a plate behind the window, so a window that lets the sky
// through (a theme with glass = true) shows the sky, not the ring's colour. Opaque windows look the same.
// Every window has an edge: a hairline of the foreground, so one that is not focused still ends somewhere
// on a dark sky, where a shadow cannot show. The focus ring sits outside it. It is said in a window rule
// because a rule wins over the layout's own "border { off; }" in a home's defaults.kdl.
window-rule {
    draw-border-with-background false
    border {
        on
        width 1
        active-color "{{foreground}}30"
        inactive-color "{{foreground}}2a"
    }
}
