[Unit]
Description=Takumi clipboard history (what you copy, for the Palette's clipboard rows)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Every copy, text or picture, goes to cliphist; takumi clipboard keep drops what a password manager
# marks sensitive, and the history keeps the last 200.
ExecStart=/usr/bin/wl-paste --watch /usr/bin/takumi clipboard keep
Restart=on-failure
RestartSec=2
