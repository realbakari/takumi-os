[Plymouth Theme]
Name=Takumi
Description=The 匠 tile on the night, with a light that runs along a line while the computer starts
ModuleName=two-step

[two-step]
Font=Inter 12
TitleFont=Inter Light 22
ImageDir=/usr/share/plymouth/themes/takumi
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
HorizontalAlignment=.5
VerticalAlignment=.56
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.62
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.3
MessageBelowAnimation=true
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0b0f14
BackgroundEndColor=0x0b0f14
ProgressBarBackgroundColor=0x1b2530
ProgressBarForegroundColor=0x5ad7ff

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
UseProgressBar=true
ProgressBarShowPercentComplete=true
Title=Putting the update in place
SubTitle=Keep the computer on
