// Takumi: an administrator at the computer may start or stop the build of the next room with waiting updates
// (takumi update prepare, docs/updates.md). Nothing else is allowed by this rule.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "takumi-update-build.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
